{
  "schema": "niloblog-integration-plan-v1",
  "repository": "getsalet/nono",
  "branch": "main",
  "provider": "niloblog",
  "public_url": "https://afp.niloblog.com/",
  "credential_secret_names": {
    "username": "NILOBLOG_USERNAME",
    "password": "NILOBLOG_PASSWORD"
  },
  "credential_values_stored": false,
  "credentials_verified": false,
  "matrix_path": "data/niloblog/title-matrix.json",
  "article_targets_path": "data/niloblog/article-targets.json",
  "publication_enabled": false,
  "workflow_enabled": false,
  "native_adapter_status": "not_implemented",
  "image_status": "awaiting_user_image_url",
  "image_generation_enabled": false,
  "content_style": "original_educational_article_not_link_farm",
  "activation_requires": [
    "explicit publication authorization",
    "native draft/save/public receipt tests",
    "local cultivation source review",
    "article destination and factual review",
    "cross-blog semantic originality check",
    "global pause and publication budget enforcement"
  ],
  "seo_profile": {
    "title_target_chars": [
      50,
      70
    ],
    "title_hard_max_chars": 78,
    "title_limit_note": "A practical editorial cap, not a universal Google ranking rule or guaranteed display width.",
    "article_target_words": [
      600,
      900
    ],
    "article_review_max_words": 1100,
    "word_count_is_not_ranking_factor": true,
    "no_padding_to_hit_minimum": true,
    "no_automatic_truncation_of_essential_caveats": true,
    "meta_description_target_chars": [
      120,
      155
    ],
    "h1_count": 1,
    "h2_target_count": [
      3,
      5
    ],
    "paragraph_style": "short focused paragraphs; no repetition to increase length",
    "keyword_style": "natural context; no density quota, no city-name stuffing",
    "links": [
      2,
      3
    ],
    "image_status": "awaiting_user_image_url"
  }
}
